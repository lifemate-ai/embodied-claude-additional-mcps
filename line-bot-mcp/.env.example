# ── LINE Messaging API (送信: AI -> owner) ───────────────────────
# LINE Developers Console > Messaging API channel で発行
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
# webhook 受信時の CloudWatch ログに出る source.userId（プロフィール画面の ID とは別物）
LINE_OWNER_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AWS DynamoDB (受信: owner -> AI のポーラー) ──────────────────
# IAM ユーザー line-poller のアクセスキー（Query/UpdateItem/GetItem のみ）
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_INBOX_TABLE=line-inbox
LINE_INBOX_INDEX=unprocessed-index
# ポーラーが書き出すローカル受信箱（hook が drain する）
LINE_INBOX_JSONL=/Users/mizushima/.claude/line_inbox.jsonl

# ── メディア送信 (画像/音声: AI -> owner) ──────────────────────────
# S3 バケット名（template.yaml の出力 MediaBucketName を設定）。presigned URL で配信。
# 未設定なら send_line_image / send_line_audio は明示エラーを返すだけ（他機能に影響なし）。
LINE_MEDIA_S3_BUCKET=line-bot-media-xxxxxxxx
# presigned URL の有効期限（秒, 既定 900=15分）
LINE_MEDIA_URL_TTL=900
