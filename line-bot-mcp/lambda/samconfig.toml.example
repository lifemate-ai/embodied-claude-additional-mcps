# Copy to samconfig.toml (gitignored) after `sam deploy --guided`, or edit and use directly.
version = 0.1

[default.deploy.parameters]
stack_name = "kokone-line-bot"
region = "ap-northeast-1"
capabilities = "CAPABILITY_IAM"
resolve_s3 = true
confirm_changeset = true
# LineChannelSecret is secret — pass it at deploy time instead of committing it here:
#   sam deploy --parameter-overrides "LineChannelSecret=xxxx LineKoutaUserId=Uyyyy"
parameter_overrides = "LineKoutaUserId=\"\""
